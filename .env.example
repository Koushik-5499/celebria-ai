# Celebria AI — Environment Configuration Example
# Copy this file to .env and provide your actual API keys

# Server Configuration
PORT=5000
NODE_ENV=production

# Google Gemini AI Integration
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable model (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Cloud Firestore / Firebase Integration
# If omitted, Celebria AI automatically runs in resilient local-first mode
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
